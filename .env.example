# Discord webhook URL (required)
# Get yours: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# How often to scan (in hours) — used by cron setup
SCAN_INTERVAL_HOURS=2

# Minimum relevance score (0-100) to trigger notification
MIN_RELEVANCE_SCORE=30

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
